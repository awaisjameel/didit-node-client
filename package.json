{
  "name": "didit-node-client",
  "version": "3.0.0",
  "description": "Official-grade Node.js / TypeScript client for the Didit Identity Verification API (v3): sessions, KYC/KYB, standalone ID verification, and secure webhook handling.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "MIGRATION.md",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test -- --ci && npm run build && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint --type-aware --deny-warnings src && oxlint --deny-warnings scripts examples",
    "lint:fix": "oxlint --type-aware --fix src && oxlint --fix scripts examples",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "didit",
    "verification",
    "identity-verification",
    "kyc",
    "kyb",
    "aml",
    "liveness",
    "biometric",
    "face-match",
    "nfc",
    "proof-of-address",
    "webhook",
    "typescript",
    "sdk"
  ],
  "author": "Awais Jameel",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "dependencies": {
    "@types/express": "^4.17.25 || ^5.0.6",
    "axios": "^1.21.0",
    "form-data": "^4.0.6"
  },
  "peerDependencies": {
    "express": "^4.22.3 || ^5.3.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaisjameel/didit-node-client.git"
  },
  "bugs": {
    "url": "https://github.com/awaisjameel/didit-node-client/issues"
  },
  "homepage": "https://github.com/awaisjameel/didit-node-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "@swc/core@1.16.20": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
