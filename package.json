{
  "name": "didit-node-client",
  "version": "2.0.0",
  "description": "Official-grade Node.js / TypeScript client for the Didit Identity Verification API (v3): sessions, KYC/KYB, standalone ID verification, and secure webhook handling.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm run lint && npm run test -- --ci && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.js\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.js\" \"*.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "didit",
    "verification",
    "identity-verification",
    "kyc",
    "kyb",
    "aml",
    "liveness",
    "biometric",
    "face-match",
    "nfc",
    "proof-of-address",
    "webhook",
    "typescript",
    "sdk"
  ],
  "author": "Awais Jameel",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "axios": "^1.18.1",
    "form-data": "^4.0.6"
  },
  "peerDependencies": {
    "express": ">=4.17.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaisjameel/didit-node-client.git"
  },
  "bugs": {
    "url": "https://github.com/awaisjameel/didit-node-client/issues"
  },
  "homepage": "https://github.com/awaisjameel/didit-node-client#readme",
  "publishConfig": {
    "access": "public"
  }
}